document.addEventListener('DOMContentLoaded', async function() {
  const version_data = await docsVersionMenu.addVersionsMenu({
    badgeOnly: {{ badge_only|tojson }},
    menuTitle: {{ menu_title|tojson }},
    projectLinks: {{ project_links|tojson }},
    githubProjectUrl: {{ github_project_url|tojson }},
  });
  // add additional customisation after rendering of menu if needed
});
